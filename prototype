def init_state() -> None:
    if "listings" not in st.session_state:
        st.session_state.listings = deepcopy(BASE_LISTINGS)
    if "user_name" not in st.session_state:
        st.session_state.user_name = "Guest"
    if "user_role" not in st.session_state:
        st.session_state.user_role = "Viewer"
    if "selected_listing_id" not in st.session_state:
        st.session_state.selected_listing_id = None
    if "selected_seats" not in st.session_state:
        st.session_state.selected_seats = []
    if "receipt" not in st.session_state:
        st.session_state.receipt = None


def listing_color(category: str) -> str:
    return CATEGORY_COLORS.get(category, "#c85a32")


def rupees(amount: float) -> str:
    return f"₹{amount:,.2f}"


def get_filtered_listings(area: str, category: str, subcategory: str, query: str):
    filtered = []
    for item in st.session_state.listings:
        matches_area = item.get("location") == area
        matches_cat = category == "All" or item.get("category") == category
        matches_sub = (
            category != "Handicrafts"
            or subcategory == "All"
            or item.get("craftSubcategory") == subcategory
        )
        text_blob = " ".join(
            [
                str(item.get("artistName", "")),
                str(item.get("title", "")),
                str(item.get("aboutExp", "")),
                str(item.get("history", "")),
                str(item.get("placeDesc", "")),
                str(item.get("craftSubcategory", "")),
            ]
        ).lower()
        matches_query = query.lower() in text_blob
        if matches_area and matches_cat and matches_sub and matches_query:
            filtered.append(item)

    if not filtered:
        fallback = []
        for item in st.session_state.listings:
            if category == "All" or item.get("category") == category:
                text_blob = " ".join(
                    [
                        str(item.get("artistName", "")),
                        str(item.get("title", "")),
                        str(item.get("aboutExp", "")),
                        str(item.get("history", "")),
                        str(item.get("placeDesc", "")),
                        str(item.get("craftSubcategory", "")),
                    ]
                ).lower()
                if query.lower() in text_blob:
                    fallback.append(item)
        return fallback

    return filtered


def build_map_dataframe(listings: list[dict], selected_area: str) -> pd.DataFrame:
    base_lat, base_lon = AREA_CENTERS[selected_area]
    rows = []
    for item in listings:
        map_x = float(item.get("mapX", 0.5))
        map_y = float(item.get("mapY", 0.5))
        rows.append(
            {
                "lat": base_lat + ((map_y - 0.5) * 0.06),
                "lon": base_lon + ((map_x - 0.5) * 0.06),
                "name": item.get("artistName"),
                "category": item.get("category"),
            }
        )
    return pd.DataFrame(rows)


