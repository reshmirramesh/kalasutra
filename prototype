def render_listing_grid(listings: list[dict]) -> None:
    cols = st.columns(3)
    for idx, item in enumerate(listings):
        with cols[idx % 3]:
            st.image(item.get("img"), use_container_width=True)
            cat = item.get("category")
            subcat = item.get("craftSubcategory")
            label = f"{cat}"
            if subcat:
                label = f"{label} • {subcat}"

            badge = f"<span style='background:{listing_color(cat)};color:#fff;padding:4px 8px;border-radius:999px;font-size:12px;font-weight:600;'>{label}</span>"
            st.markdown(badge, unsafe_allow_html=True)
            st.markdown(f"### {item.get('title')}")
            st.caption(item.get("artistName"))
            st.write(item.get("aboutExp") or item.get("placeDesc") or item.get("history"))
            customer_price = item.get("baseCost", 0) * 1.02
            st.markdown(f"**Customer Price (incl. 2% fee): {rupees(customer_price)}**")
            if st.button("Explore & Book", key=f"book_{item.get('id')}", use_container_width=True):
                st.session_state.selected_listing_id = item.get("id")
                st.session_state.selected_seats = []


def render_detail_and_checkout(selected_item: dict) -> None:
    st.markdown("---")
    st.subheader("Listing Details")
    st.image(selected_item.get("img"), use_container_width=True)

    st.markdown(
        f"<span style='background:{listing_color(selected_item.get('category'))};color:#fff;padding:4px 10px;border-radius:999px;font-size:12px;font-weight:600;'>{selected_item.get('category')}</span>",
        unsafe_allow_html=True,
    )
    st.markdown(f"## {selected_item.get('title')}")
    st.caption(f"Custodian: {selected_item.get('artistName')} | Location: {selected_item.get('location')}")

    category = selected_item.get("category")

    if category in ["Dramatics", "Music", "Dance", "Rituals"]:
        c1, c2, c3 = st.columns(3)
        c1.metric("Language", selected_item.get("language", "-"))
        c2.metric("Genre", selected_item.get("genre", "-"))
        c3.metric("Created By", selected_item.get("createdBy", "-"))
        st.write(f"**About the Experience:** {selected_item.get('aboutExp', '-')}")
        st.write(f"**About the Artist:** {selected_item.get('aboutArtist', '-')}")
        st.write(f"**History:** {selected_item.get('history', '-')}")

        if selected_item.get("isSeatedShow", False):
            st.markdown("### Pick Your Show Seats")
            all_seats = [f"{r}{n}" for r in ["A", "B", "C", "D"] for n in range(1, 9)]
            reserved = {"A3", "A4"}
            available = [seat for seat in all_seats if seat not in reserved]
            selected = st.multiselect(
                "Available seats",
                options=available,
                default=st.session_state.selected_seats,
                help="Reserved seats: A3, A4",
            )
            st.session_state.selected_seats = selected

    elif category == "Heritage Experiences":
        c1, c2 = st.columns(2)
        c1.metric("Language", selected_item.get("language", "-"))
        c2.metric("Genre", selected_item.get("genre", "-"))
        st.write(f"**Orator / Guide:** {selected_item.get('orator', '-')}")
        st.write(f"**Takeaway Product:** {selected_item.get('endProduct', '-')}")
        st.write(f"**Place Description & History:** {selected_item.get('placeDesc', '-')}")

    elif category == "Handicrafts":
        c1, c2 = st.columns(2)
        c1.metric("Subcategory", selected_item.get("craftSubcategory", "-"))
        c2.metric("Dimensions", selected_item.get("dimensions", "-"))
        st.write(f"**Shop / Studio Address:** {selected_item.get('shopAddr', '-')}")
        st.write(f"**Craft Details:** {selected_item.get('aboutExp', '-')}")

        if selected_item.get("craftSubcategory") in ["Furniture", "Paintings", "Home Decor"]:
            st.markdown("### Room Fit Checker")
            cw1, cw2 = st.columns(2)
            spot_w = cw1.number_input("Spot Width (ft)", min_value=0.5, value=5.0, step=0.5)
            spot_d = cw2.number_input("Spot Depth (ft)", min_value=0.5, value=3.0, step=0.5)
            if spot_w >= 4 and spot_d >= 2:
                st.success(f"Perfect Fit! Your spot ({spot_w}ft x {spot_d}ft) accommodates this item.")
            else:
                st.warning("Tight Fit: Recommended minimum is 4ft x 2ft.")

    st.markdown("### Checkout")

    seat_count = len(st.session_state.selected_seats)
    units = seat_count if seat_count > 0 else 1
    base_total = float(selected_item.get("baseCost", 0)) * units
    platform_fee = base_total * 0.02
    total = base_total + platform_fee

    c1, c2, c3 = st.columns(3)
    c1.metric("Base Price", rupees(base_total))
    c2.metric("Platform Fee (2%)", rupees(platform_fee))
    c3.metric("Total", rupees(total))

    if seat_count > 0:
        st.info(f"Selected Seats: {', '.join(st.session_state.selected_seats)}")

    with st.form("checkout_form"):
        pay_options = ["Online Gateway (UPI / Cards / Net Banking)"]
        if selected_item.get("allowOfflinePay", False):
            pay_options.append("Direct Offline Payment at Venue / Shop")

        pay_method = st.radio("Select Payment Method", pay_options)
        user_email = st.text_input("Email for Booking Ticket & Receipt Dispatch")
        confirm = st.form_submit_button("Confirm & Issue Ticket / Receipt", use_container_width=True)

    if confirm:
        if not user_email.strip():
            st.error("Email is required for booking confirmation.")
            return

        st.session_state.receipt = {
            "booking_id": f"KS-{random.randint(100000, 999999)}",
            "item_name": selected_item.get("title"),
            "custodian": selected_item.get("artistName"),
            "location": selected_item.get("location"),
            "email": user_email.strip(),
            "pay_method": pay_method,
            "seats": list(st.session_state.selected_seats),
            "total": total,
        }
        st.success("Booking confirmed. Receipt generated below.")

    if st.session_state.receipt:
        rec = st.session_state.receipt
        st.markdown("---")
        st.subheader("KalaSutra Ticket")
        st.write(f"**Booking ID:** #{rec['booking_id']}")
        st.write(f"**Item / Show:** {rec['item_name']}")
        st.write(f"**Custodian:** {rec['custodian']}")
        st.write(f"**Location:** {rec['location']}")
        st.write(f"**Customer Email:** {rec['email']}")
        if rec["seats"]:
            st.write(f"**Reserved Seats:** {', '.join(rec['seats'])}")
        st.write(f"**Payment Method:** {rec['pay_method']}")
        st.write(f"**Total Paid (inc. 2% fee):** {rupees(rec['total'])}")
        st.success("Email receipt dispatched (simulated).")


