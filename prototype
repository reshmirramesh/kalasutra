            background: linear-gradient(180deg, #fdfbf7 0%, #fff7ed 100%);
        }
        </style>
        """,
        unsafe_allow_html=True,
    )

    render_sidebar()

    st.title("KalaSutra")
    st.caption("Heritage & Artisans Hub")

    top1, top2, top3 = st.columns([2, 2, 2])
    with top1:
